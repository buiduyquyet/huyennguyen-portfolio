DATABASE_URL=mongodb+srv://<user>:<password>@cluster0.xxxx.mongodb.net/huyennguyen-portfolio?retryWrites=true&w=majority
PAYLOAD_SECRET=YOUR_SECRET_HERE
# Tuỳ chọn ở máy, BẮT BUỘC khi deploy — token của Vercel Blob store
BLOB_READ_WRITE_TOKEN=

# SMTP gửi mail (giống quyet-portfolio). Gmail: bật 2FA rồi tạo App Password tại https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
